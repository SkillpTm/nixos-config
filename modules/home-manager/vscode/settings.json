{
	"files.exclude": {
		"**/__pycache__": true,
		"**/.DS_Store": false,
		"**/.DS_STORE": true,
		"**/.gitkeep": true,
		"**/.import": true,
		"**/.mono": true,
		"**/**.import": true,
		"**/node_modules": true
	},
	"editor.accessibilitySupport": "off",
	"editor.detectIndentation": false,
	"editor.formatOnSave": true,
	"editor.inlineSuggest.enabled": true,
	"editor.insertSpaces": false,
	"editor.minimap.enabled": false,
	"editor.tabSize": 4,
	"editor.wordWrap": "on",
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	"search.maxResults": null,
	"security.workspace.trust.untrustedFiles": "open",
	"terminal.integrated.fontFamily": "MesloLGS NF",
	"terminal.integrated.sendKeybindingsToShell": true,
	"terminal.integrated.shellIntegration.enabled": false,
	"window.commandCenter": false,
	"workbench.activityBar.location": "top",
	"workbench.colorTheme": "Dark+",
	"workbench.iconTheme": "material-icon-theme",
	"workbench.preferredDarkColorTheme": "Dark+",
	"workbench.preferredHighContrastColorTheme": "Dark+",
	"workbench.preferredHighContrastLightColorTheme": "Dark+",
	"workbench.preferredLightColorTheme": "Dark+",
	"workbench.secondarySideBar.defaultVisibility": "hidden",
	"workbench.startupEditor": "none",
	"workbench.editorAssociations": {
		"*.svg": "default"
	},
	"docker.extension.dockerEngineAvailabilityPrompt": false,
	"git.confirmSync": false,
	"git.openRepositoryInParentFolders": "never",
	"liveServer.settings.donotShowInfoMsg": true,
	"[nix]": {
		"editor.detectIndentation": false,
		"editor.formatOnSave": false,
		"editor.insertSpaces": false,
		"editor.tabSize": 4
	},
	"python.defaultInterpreterPath": "/home/skillp/.pyenv/versions/3.14.0/bin/python",
	"python.terminal.activateEnvironment": false,
	"[python]": {
		"editor.insertSpaces": true,
		"editor.tabSize": 4
	},
	"python.analysis.diagnosticSeverityOverrides": {
		"reportOptionalMemberAccess": "none",
		"reportUnknownMemberType": "none",
		"reportUnknownVariableType": "none",
		"reportUnknownArgumentType": "none"
	},
	"python.analysis.inlayHints.functionReturnTypes": true,
	"python.analysis.inlayHints.variableTypes": true,
	"python.analysis.inlayHints.callArgumentNames": "all",
	"python.analysis.typeCheckingMode": "strict",
	"pylint.args": [
		"--disable=C0114",
		"--disable=C0115",
		"--disable=C0304",
		"--disable=C0415",
		"--disable=E0606",
		"--disable=E1101",
		"--disable=E1121",
		"--disable=W0102",
		"--disable=W0212",
		"--disable=W0223",
		"--disable=W0718",
		"--max-line-length=300",
		"--const-naming-style=UPPER_CASE",
		"--module-naming-style=PascalCase"
	],
	"go.lintOnSave": "workspace",
	"go.lintFlags": [
		"-checks=all,-ST1005"
	],
	"go.inlayHints.constantValues": true,
	"go.inlayHints.compositeLiteralFields": true,
	"go.inlayHints.parameterNames": true,
	"go.formatTool": "goimports",
	"go.toolsManagement.autoUpdate": true,
	"go.useLanguageServer": true,
	"[go]": {
		"editor.autoIndent": "keep",
		"editor.formatOnSave": true,
		"editor.formatOnType": false
	},
	"gopls": {
		"completeUnimported": true,
		"ui.semanticTokens": true
	},
	"chat.agent.enabled": false,
	"github.copilot.chat.agent.autoFix": false,
	"github.copilot.chat.codeGeneration.useInstructionFiles": false,
	"github.copilot.chat.copilotDebugCommand.enabled": false,
	"github.copilot.chat.customInstructionsInSystemMessage": false,
	"github.copilot.chat.edits.suggestRelatedFilesForTests": false,
	"github.copilot.chat.edits.suggestRelatedFilesFromGitHistory": false,
	"github.copilot.chat.imageUpload.enabled": false,
	"github.copilot.chat.localeOverride": "en",
	"github.copilot.chat.newWorkspaceCreation.enabled": false,
	"github.copilot.chat.reviewAgent.enabled": false,
	"github.copilot.chat.reviewSelection.enabled": false,
	"github.copilot.chat.setupTests.enabled": false,
	"github.copilot.chat.summarizeAgentConversationHistory.enabled": false,
	"github.copilot.chat.useProjectTemplates": false,
	"github.copilot.chat.useResponsesApi": false,
	"github.copilot.editor.enableCodeActions": false,
	"github.copilot.nextEditSuggestions.fixes": false,
	"github.copilot.renameSuggestions.triggerAutomatically": false,
	"github.copilot.advanced": {},
	"github.copilot.nextEditSuggestions.allowWhitespaceOnlyChanges": false,
	"github.copilot.chat.commitMessageGeneration.instructions": [
		{
			"text": "CRITICAL: You must output EXACTLY ONE commit message in total, regardless of how many files are staged or changed."
		},
		{
			"text": "Use the conventional commit format: <type>[optional scope]: <description>\n\n[optional body]"
		},
		{
			"text": "Valid types are: build, chore, docs, feat, fix, perf, refactor, style, test."
		},
		{
			"text": "If changes span multiple scopes, OMIT the scope entirely or use a broad term like '(core)'. Do not attempt to combine multiple scopes in the brackets."
		},
		{
			"text": "If changes span multiple types, choose the single most dominant type for the subject line. Summarize the rest of the changes briefly in the body if absolutely necessary."
		},
		{
			"text": "Keep the subject line description below 10 words, if possible. Only include a body if absolutly required, line breaks are forbidden, outside of description-body seperation."
		}
	]
}